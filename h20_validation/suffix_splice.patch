+def test_splice_corpus_filters_partial_and_short_matches():
+    partial_docs = [
+        [0, 1, 0, 1, 9],
+        [8, 0, 1, 20, 21],
+        [8, 0, 1, 30, 31],
+        [8, 0, 1, 40, 41],
+    ]
+    assert run_suffix_query(
+        [5, 0, 1, 0], 2, prefix=[1], docs=partial_docs, min_match=2
+    ) == ([40, 41], 2, 2)
+    short_match_docs = [
+        [0, 1, 0, 1, 20, 21],
+        [0, 1, 0, 1, 30, 31],
+        [0, 1, 0, 1, 40, 41],
+        *([[8, 0, 1, 50, 51]] * 4),
+    ]
+    assert run_suffix_query(
+        [5, 0, 1, 0], 2, prefix=[1], docs=short_match_docs, min_match=4
+    ) == ([40, 41], 2, 4)
+
