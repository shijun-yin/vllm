+
+from typing import TYPE_CHECKING
+
+import torch
+
+from vllm.config import VllmConfig
+from vllm.triton_utils import tl, triton
+from vllm.v1.worker.gpu.input_batch import InputBatch
+from vllm.v1.worker.gpu.spec_decode.suffix.speculator import (
+    _NUM_LEN_BUCKETS,
+    SuffixSpeculator,
+    _len_bucket,
+)
+
+if TYPE_CHECKING:
+    from collections.abc import Iterable
+
+    from vllm.v1.worker.gpu.states import RequestState
+
+_MIN_OBSERVATIONS = tl.constexpr(8)
+
+
+@triton.jit
+def _hybrid_route_publish_kernel(
+    num_valid_ptr,
+    match_lens_ptr,
+    sources_ptr,
+    model_drafts_ptr,
+    model_drafts_stride,
+    suffix_drafts_ptr,
+    suffix_drafts_stride,
+    model_stats_ptr,
+    suffix_stats_ptr,
+    structured_output_mask_ptr,
+    idx_mapping_ptr,
+    num_sampled_ptr,
+    route_index,
+    output_ptr,
+    output_stride,
+    last_use_suffix_ptr,
+    last_buckets_ptr,
+    last_valid_ptr,
+    MIN_MATCH: tl.constexpr,
+    K: tl.constexpr,
+    STATS_K: tl.constexpr,
+    K_PO2: tl.constexpr,
+    PREFIX: tl.constexpr,
+    QUALITY_GATE: tl.constexpr,
+    MIN_EXPECTED: tl.constexpr,
+    EXPLORATION_INTERVAL: tl.constexpr,
+):
+    b = tl.program_id(0)
+    k = tl.arange(0, K_PO2)
+    mask = k < K
